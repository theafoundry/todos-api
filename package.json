{
  "name": "todos-api",
  "version": "1.6.0",
  "main": "index.js",
  "bin": {
    "td": "./dist/cli/index.js"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "npx prisma generate && tsc",
    "postinstall": "npm run build",
    "check:architecture": "node scripts/check-architecture-invariants.mjs",
    "check:harness-drift": "node scripts/check-harness-drift.mjs",
    "tokens:to-swift": "ts-node scripts/tokens-to-swift.ts",
    "tokens:check": "ts-node scripts/tokens-to-swift.ts --check",
    "harness:cleanup-report": "node scripts/harness/cleanup-report.mjs",
    "test": "npm run test:unit",
    "test:all": "NODE_ENV=test jest --runInBand",
    "test:unit": "NODE_ENV=test SKIP_DB_SETUP=true jest --config jest.unit.config.js --runInBand",
    "test:mcp": "NODE_ENV=test SKIP_DB_SETUP=true jest --config jest.mcp.config.js --runInBand",
    "test:integration": "NODE_ENV=test EMAIL_FEATURES_ENABLED=false jest --config jest.integration.config.js --runInBand",
    "test:ci": "npx tsc --noEmit && npm run test:unit",
    "eval:agent": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js agent",
    "eval:decision-assist": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js decision-assist",
    "eval:mcp": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js mcp",
    "eval:plugin": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js plugin",
    "configure:plugin-app": "node scripts/configure-todos-plugin-app.mjs",
    "validate:plugin": "node scripts/validate-todos-plugin-package.mjs",
    "eval:planner": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js planner",
    "eval:all": "./node_modules/.bin/tsc && NODE_ENV=test node evals/run-suite.js all",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand",
    "test:coverage:check": "NODE_ENV=test SKIP_DB_SETUP=true jest --config jest.unit.config.js --runInBand --coverage --coverageReporters=json-summary && node scripts/check-coverage-ratchet.mjs",
    "test:ui": "start-server-and-test preview:static http://127.0.0.1:4173/app/ \"playwright test\"",
    "test:ui:fast": "start-server-and-test preview:static http://127.0.0.1:4173/app/ \"playwright test --grep-invert @visual\"",
    "test:ui:headed": "start-server-and-test preview:static http://127.0.0.1:4173/app/ \"playwright test --headed\"",
    "test:ui:update": "start-server-and-test preview:static http://127.0.0.1:4173/app/ \"playwright test --update-snapshots\"",
    "preview:static": "node scripts/ui-static-server.mjs",
    "format:check": "prettier --check \"{src,test,tests,prisma,scripts}/**/*.{ts,js,json,md,html,css}\" \"*.{md,json,yml,yaml}\" \".github/workflows/*.{yml,yaml}\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:migrate:status": "npx prisma migrate status",
    "prisma:migrate:check": "npx prisma validate",
    "snapshot:mcp-app:phase2": "tsc && node scripts/generate-mcp-app-phase2-snapshot.mjs",
    "snapshot:mcp-app:check": "tsc && node scripts/generate-mcp-app-phase2-snapshot.mjs --check",
    "review:reset": "ts-node scripts/review/reset-review-account.ts",
    "review:metadata": "npm run snapshot:mcp-app:check",
    "review:portal-scan": "node scripts/review/compare-portal-scan.mjs",
    "review:challenge": "node scripts/review/run-http-check.mjs challenge",
    "review:discovery": "node scripts/review/run-http-check.mjs discovery",
    "review:oauth": "node scripts/review/run-http-check.mjs oauth",
    "review:userinfo": "node scripts/review/run-http-check.mjs userinfo",
    "review:policies": "node scripts/review/run-http-check.mjs policies",
    "review:widget": "node scripts/review/run-http-check.mjs widget",
    "review:accessibility": "playwright test tests/ui/today-plan-widget.spec.ts",
    "review:security": "npm run test:mcp && npm run audit:prod",
    "review:acceptance": "node scripts/review/acceptance.mjs",
    "prisma:studio": "npx prisma studio",
    "prisma:reset": "npx prisma migrate reset",
    "docker:up": "docker compose up -d postgres",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d postgres",
    "docker:logs": "docker compose logs -f postgres",
    "db:start": "npm run docker:up",
    "db:stop": "npm run docker:down",
    "db:logs": "npm run docker:logs",
    "db:psql": "docker compose exec postgres psql -U postgres -d todos_dev",
    "db:wait": "docker compose exec postgres sh -c 'until pg_isready -U postgres -d todos_dev; do sleep 1; done'",
    "db:reset": "npm run docker:reset && npm run db:wait && npm run prisma:migrate",
    "db:setup": "npm run docker:up && npm run db:wait && npm run prisma:migrate",
    "db:seed": "ts-node prisma/seed.ts",
    "dev:react": "npm --prefix client-react run dev",
    "dev:https": "bash scripts/dev-https.sh",
    "https:certs": "bash scripts/generate-local-https-certs.sh",
    "https:proxy": "caddy run --config Caddyfile.local",
    "build:react": "npm --prefix client-react install --include=dev && npm --prefix client-react run build:all",
    "preview:react": "UI_PORT=4173 node scripts/ui-static-server.mjs",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/node": "^8.55.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcrypt": "^6.0.0",
    "chrono-node": "^2.9.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "picocolors": "^1.1.1",
    "prisma": "^7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "html-validate": "^10.13.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "linkinator": "^7.6.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.12",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "start-server-and-test": "^2.1.3",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  },
  "overrides": {
    "@hono/node-server": "2.1.0",
    "axios": "1.19.0",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "effect": "^3.21.0",
    "fast-uri": "4.1.2",
    "hono": "4.13.1",
    "ip-address": "10.5.0",
    "js-yaml": "5.2.3",
    "qs": "6.15.3",
    "swagger-jsdoc": {
      "glob": "^11.0.0"
    },
    "valibot": "1.4.2"
  }
}
