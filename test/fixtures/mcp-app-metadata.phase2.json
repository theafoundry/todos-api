        "securitySchemes": [
          { "type": "oauth2", "scopes": ["tasks.read", "projects.read"] }
        ],
        "openai/toolInvocation/invoking": "Running list today's tasks…",
        "openai/toolInvocation/invoked": "List today's tasks complete"
      }
    },
